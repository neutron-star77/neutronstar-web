---
import { site } from "../../config/site";

const year = new Date().getFullYear();
---

<footer
  class="mt-16 border-t border-outline-variant/40 py-8 text-xs text-on-surface-variant"
>
  <div
    class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-3 px-4 sm:flex-row"
  >
    <p>&copy; {year} {site.name} · Powered by Astro</p>
    <div class="flex items-center gap-4">
      {
        site.social.map((item) => (
          <a href={item.href} class="hover:text-primary" rel="noopener">
            {item.label}
          </a>
        ))
      }
    </div>
  </div>
</footer>
