---
import SurfaceCard from "../ui/SurfaceCard.astro";
import { site } from "../../config/site";

const days = Math.max(
  1,
  Math.floor((Date.now() - new Date(site.since).getTime()) / 86_400_000)
);
---

<SurfaceCard variant="container">
  <div class="flex items-center gap-3">
    <img
      src={site.author.avatar}
      alt={site.author.name}
      width="48"
      height="48"
      loading="lazy"
      decoding="async"
      class="size-12 rounded-full bg-secondary-container object-cover"
    />
    <div class="min-w-0">
      <p class="truncate text-sm font-medium text-on-surface">{site.author.name}</p>
      <p class="truncate text-xs text-on-surface-variant">{site.author.bio}</p>
    </div>
  </div>

  <dl class="mt-4 grid grid-cols-3 gap-2 text-center">
    <div class="rounded-m3-sm bg-surface-container-high py-2">
      <dt class="text-[10px] uppercase tracking-wider text-on-surface-variant">Posts</dt>
      <dd class="text-sm font-semibold text-on-surface">20</dd>
    </div>
    <div class="rounded-m3-sm bg-surface-container-high py-2">
      <dt class="text-[10px] uppercase tracking-wider text-on-surface-variant">Moments</dt>
      <dd class="text-sm font-semibold text-on-surface">6</dd>
    </div>
    <div class="rounded-m3-sm bg-surface-container-high py-2">
      <dt class="text-[10px] uppercase tracking-wider text-on-surface-variant">Uptime</dt>
      <dd class="text-sm font-semibold text-on-surface">{days}</dd>
    </div>
  </dl>
</SurfaceCard>
