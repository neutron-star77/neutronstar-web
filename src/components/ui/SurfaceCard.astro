---
/**
 * M3 表面卡片：统一的容器层级、圆角与高度。
 * hover 只做 translateY（合成层），不改布局，不影响 CLS。
 */
interface Props {
  /** 标题（大写小字距，Shirone 侧栏风格） */
  title?: string;
  /** 容器层级：container（默认） / high / outlined */
  variant?: "container" | "high" | "outlined";
  /** 是否启用 hover 抬升（交互型卡片才开） */
  interactive?: boolean;
  class?: string;
}

const { title, variant = "container", interactive = false, class: className = "" } = Astro.props;

const surfaces = {
  container: "bg-surface-container",
  high: "bg-surface-container-high",
  outlined: "border border-outline-variant bg-transparent",
} as const;
---

<section
  class:list={[
    "rounded-m3 p-4 shadow-elevation-1",
    surfaces[variant],
    interactive && "transition-transform hover:-translate-y-0.5 hover:shadow-elevation-2",
    className,
  ]}
>
  {
    title && (
      <h2 class="mb-3 text-[11px] font-semibold uppercase tracking-[0.18em] text-on-surface-variant">
        {title}
      </h2>
    )
  }
  <slot />
</section>
