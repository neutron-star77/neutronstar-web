---
import { getSiteOverrides } from "@utils/site-overrides";
import { resolveTextureOptions, siteConfig } from "@/config";

const overrides = await getSiteOverrides();
const display = overrides.display;
const textureOptions = resolveTextureOptions(
	display?.texturePreset || display?.textureOpacity !== undefined
		? {
				...siteConfig.texture,
				defaultPreset: display?.texturePreset ?? siteConfig.texture.defaultPreset,
				defaultOpacity:
					display?.textureOpacity ?? siteConfig.texture.defaultOpacity,
			}
		: siteConfig.texture,
);
const hue = display?.hue ?? siteConfig.themeColor.hue;
---

<div
	id="config-carrier"
	data-hue={hue}
	data-wallpaper-mode={siteConfig.wallpaperMode.defaultMode}
	{...(textureOptions.enable
		? {
				"data-texture-preset": textureOptions.defaultPreset,
				"data-texture-opacity": textureOptions.defaultOpacity,
			}
		: {})}
>
</div>
