---
/**
 * ArchiveRiver —— Nebula 风格「SVG 河流横向拖拽时间轴」（归档页）。
 *
 * 视觉规格来源：.scratch/nebula-replica/layouts.md §6（归档）。
 * - 视口 overflow-x:auto + 隐藏滚动条 + pointer 拖拽滚动（grab/grabbing，拖后抑制点击）。
 * - SVG 河流曲线贯穿水平中央（三层发光描边 + 渐变主线 + 沿路径流动粒子）。
 * - 每篇文章一个节点（白点 r6 + 发光圈 + 虚线连接线上下交替），
 *   节点上/下交替挂 280×310 玻璃卡（封面无则纯文字卡），间隔 40px。
 * - 无障碍：外层提供同内容纵向列表（sr-only；reduced-motion 时转正显示、
 *   河流隐藏、拖拽 JS 不绑定、粒子与入场动画关闭，仅保留原生滚动）。
 *
 * 数据形态：PostEntry（@utils/content-utils 鸭子类型），仅读
 *   slug / data.title / data.published / data.description / data.category / data.image。
 * 展示顺序：归档按时间轴从左（旧）到右（新），故对传入列表做一次反转呈现。
 */
import type { PostEntry } from "@utils/content-utils";

interface Props {
	posts: PostEntry[];
}

const { posts } = Astro.props;

/* ── 几何常量（Nebula 规格：卡 280×310，间隔 40px） ─────────────── */
const CARD_W = 280;
const CARD_H = 310;
const SPACING = CARD_W + 40; // 320
const PAD_X = 170; // 两端留半卡 + 余量
const CONNECT = 64; // 连接线长度
const AMP = 34; // 河流波动振幅
const RIVER_Y = CARD_H + CONNECT + AMP; // 408，河流基准线
const STAGE_H = RIVER_Y * 2; // 816

const ordered = [...posts].reverse(); // 时间轴：旧 → 新
const n = ordered.length;
const firstNodeX = PAD_X + CARD_W / 2;
const stageW = n > 0 ? PAD_X * 2 + (n - 1) * SPACING + CARD_W : 0;
const wave = (x: number): number =>
	RIVER_Y + AMP * Math.sin(((x - firstNodeX) / SPACING) * 1.05 + 0.4);

/** 河流曲线路径（逐 12px 采样，振幅小、视觉平滑） */
let riverPath = "";
if (n > 0) {
	const pts: string[] = [];
	for (let x = 0; x <= stageW; x += 12) {
		pts.push(`${x.toFixed(1)},${wave(x).toFixed(1)}`);
	}
	riverPath = "M" + pts.join(" L");
}

/** 每篇文章的节点/卡片定位与内容 */
const items = ordered.map((post, i) => {
	const x = firstNodeX + i * SPACING;
	const y = wave(x);
	const up = i % 2 === 0; // 交替：偶数上、奇数下
	return {
		i,
		x: Math.round(x * 10) / 10,
		y: Math.round(y * 10) / 10,
		up,
		cardX: PAD_X + i * SPACING,
		cardTop: up ? 0 : STAGE_H - CARD_H,
		url: `/posts/${post.slug}/`,
		title: post.data.title,
		description: post.data.description || "",
		category: post.data.category || "记录",
		cover: post.data.image || "",
		dateISO: post.data.published.toISOString(),
		dateLabel: post.data.published.toLocaleDateString("zh-CN"),
	};
});
---

{
	n > 0 && (
		<div class="nb-river" data-river-drag>
			<div class="nb-river-stage" style={`width:${stageW}px;height:${STAGE_H}px;`}>
				<svg
					class="nb-river-svg"
					width={stageW}
					height={STAGE_H}
					viewBox={`0 0 ${stageW} ${STAGE_H}`}
					fill="none"
					aria-hidden="true"
				>
					<defs>
						<linearGradient id="nb-river-grad" x1="0" y1="0" x2="1" y2="0">
							<stop offset="0" stop-color="#7dd3fc" />
							<stop offset="0.5" stop-color="#60a5fa" />
							<stop offset="1" stop-color="#a78bfa" />
						</linearGradient>
						<filter id="nb-river-blur" x="-5%" y="-300%" width="110%" height="700%">
							<feGaussianBlur stdDeviation="5" />
						</filter>
					</defs>

					{/* 河流：三层发光描边 + 渐变主线 */}
					<path
						d={riverPath}
						stroke="#7dd3fc"
						stroke-width="14"
						stroke-linecap="round"
						opacity="0.10"
						filter="url(#nb-river-blur)"
					/>
					<path
						d={riverPath}
						stroke="#60a5fa"
						stroke-width="6"
						stroke-linecap="round"
						opacity="0.22"
						filter="url(#nb-river-blur)"
					/>
					<path
						d={riverPath}
						stroke="url(#nb-river-grad)"
						stroke-width="2.2"
						stroke-linecap="round"
						opacity="0.95"
					/>

					{/* 沿路径流动的粒子（reduced-motion 时 CSS 隐藏） */}
					<g class="nb-river-particles">
						<circle r="3.2" fill="#7dd3fc">
							<animateMotion dur="16s" repeatCount="indefinite" path={riverPath} />
						</circle>
						<circle r="2.4" fill="#60a5fa" opacity="0.9">
							<animateMotion dur="20s" begin="-7s" repeatCount="indefinite" path={riverPath} />
						</circle>
						<circle r="2" fill="#a78bfa" opacity="0.85">
							<animateMotion dur="24s" begin="-13s" repeatCount="indefinite" path={riverPath} />
						</circle>
					</g>

					{/* 节点 + 上下交替虚线连接线 */}
					{items.map((it) => (
						<g>
							<line
								x1={it.x}
								y1={it.up ? CARD_H : it.y + 12}
								x2={it.x}
								y2={it.up ? it.y - 12 : STAGE_H - CARD_H}
								stroke="#7dd3fc"
								stroke-width="1.4"
								stroke-dasharray="3 5"
								opacity="0.55"
							/>
							<circle cx={it.x} cy={it.y} r="13" fill="rgba(125, 211, 252, 0.16)" />
							<circle
								cx={it.x}
								cy={it.y}
								r="9"
								fill="none"
								stroke="rgba(125, 211, 252, 0.5)"
								stroke-width="1.5"
							/>
							<circle cx={it.x} cy={it.y} r="6" fill="#ffffff" />
						</g>
					))}
				</svg>

				{/* 玻璃卡层（HTML 绝对定位，280×310，上下交替） */}
				{items.map((it) => (
					<a
						class="nb-rcard"
						class:list={{ "is-up": it.up, "is-down": !it.up }}
						style={`left:${it.cardX}px;top:${it.cardTop}px;animation-delay:${it.i * 40}ms;`}
						href={it.url}
					>
						{it.cover ? (
							<div class="nb-rcard__cover">
								<img src={it.cover} alt="" loading="lazy" decoding="async" />
								<time class="nb-rcard__date nb-rcard__date--overlay" datetime={it.dateISO}>
									{it.dateLabel}
								</time>
							</div>
						) : (
							<time class="nb-rcard__date" datetime={it.dateISO}>
								{it.dateLabel}
							</time>
						)}
						<h3 class="nb-rcard__title">{it.title}</h3>
						{it.description && <p class="nb-rcard__excerpt">{it.description}</p>}
						<span class="nb-rcard__pill">{it.category}</span>
					</a>
				))}
			</div>
		</div>
	)
}

{/* 无障碍降级：同内容纵向列表（sr-only；reduced-motion 时转正显示） */}
<nav class="nb-river-fallback" aria-label="文章归档列表">
	<ul>
		{n === 0 && <li>暂无文章。</li>}
		{items.map((it) => (
			<li>
				<a href={it.url}>
					<time datetime={it.dateISO}>{it.dateLabel}</time>
					<span class="nb-river-fallback__cat">{it.category}</span>
					<strong>{it.title}</strong>
				</a>
			</li>
		))}
	</ul>
</nav>

<script>
	// 河流拖拽滚动（Nebula archive）：鼠标/触控笔按住拖动，拖后抑制点击。
	// prefers-reduced-motion 时不绑定，仅保留原生滚动。
	const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

	function initRiver(vp: HTMLElement) {
		let dragging = false;
		let moved = false;
		let startX = 0;
		let startLeft = 0;

		vp.addEventListener("pointerdown", (e: PointerEvent) => {
			if (e.pointerType === "touch") return; // 触屏走原生横向滚动
			dragging = true;
			moved = false;
			startX = e.clientX;
			startLeft = vp.scrollLeft;
			vp.classList.add("is-dragging");
			try {
				vp.setPointerCapture(e.pointerId);
			} catch {
				/* 忽略捕获失败 */
			}
		});

		vp.addEventListener("pointermove", (e: PointerEvent) => {
			if (!dragging) return;
			const dx = e.clientX - startX;
			if (Math.abs(dx) > 6) moved = true;
			vp.scrollLeft = startLeft - dx;
		});

		const endDrag = () => {
			if (!dragging) return;
			dragging = false;
			vp.classList.remove("is-dragging");
			setTimeout(() => (moved = false), 60); // click 在 pointerup 之后派发，稍后复位
		};
		vp.addEventListener("pointerup", endDrag);
		vp.addEventListener("pointercancel", endDrag);

		vp.addEventListener(
			"click",
			(e: MouseEvent) => {
				if (moved) {
					e.preventDefault();
					e.stopPropagation();
					moved = false;
				}
			},
			true,
		);

		// 初始定位到最新一端（时间轴右侧）
		vp.scrollLeft = vp.scrollWidth;
	}

	if (!reduced) {
		document.querySelectorAll<HTMLElement>("[data-river-drag]").forEach(initRiver);
	} else {
		// reduced-motion：只把视口滚到最新一端，不接管拖拽
		document.querySelectorAll<HTMLElement>("[data-river-drag]").forEach((vp) => {
			vp.scrollLeft = vp.scrollWidth;
		});
	}
</script>

<style>
	.nb-river {
		overflow-x: auto;
		overflow-y: hidden;
		cursor: grab;
		user-select: none;
		-webkit-user-select: none;
		scrollbar-width: none;
		-webkit-overflow-scrolling: touch;
		touch-action: pan-x pan-y;
		padding-block: 0.5rem;
	}
	.nb-river::-webkit-scrollbar {
		display: none;
	}
	.nb-river.is-dragging {
		cursor: grabbing;
	}

	.nb-river-stage {
		position: relative;
	}
	.nb-river-svg {
		position: absolute;
		inset: 0;
		display: block;
		pointer-events: none;
	}
	.nb-river-particles circle {
		filter: drop-shadow(0 0 4px rgba(125, 211, 252, 0.9));
	}

	/* ── 玻璃卡（280×310，与 nebula.css 玻璃令牌一致） ─────────────── */
	.nb-rcard {
		position: absolute;
		z-index: 2;
		width: 280px;
		height: 310px;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 1rem 1.1rem;
		background: var(--nebula-glass-fill, rgba(255, 255, 255, 0.08));
		border: 1px solid var(--nebula-glass-border, rgba(255, 255, 255, 0.12));
		border-radius: var(--nebula-glass-radius, 16px);
		backdrop-filter: blur(var(--nebula-glass-blur, 12px)) saturate(1.25);
		-webkit-backdrop-filter: blur(var(--nebula-glass-blur, 12px)) saturate(1.25);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.12),
			inset 0 0 20px rgba(125, 211, 252, 0.05),
			0 8px 28px rgba(0, 0, 0, 0.35);
		color: var(--nebula-ink, #e7ecf7);
		text-decoration: none;
		animation: nb-river-rise 0.5s ease backwards;
		transition:
			transform 0.2s ease,
			border-color 0.2s ease,
			box-shadow 0.2s ease;
	}
	.nb-rcard:hover {
		transform: translateY(-3px);
		border-color: rgba(96, 165, 250, 0.7);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.12),
			0 14px 36px rgba(0, 0, 0, 0.45),
			0 0 18px rgba(96, 165, 250, 0.25);
	}
	.nb-rcard:focus-visible {
		outline: 2px solid var(--nebula-cyan, #7dd3fc);
		outline-offset: 4px;
	}
	@keyframes nb-river-rise {
		from {
			opacity: 0;
			transform: translateY(26px);
		}
	}

	.nb-rcard__cover {
		position: relative;
		margin: -1rem -1.1rem 0;
		height: 148px;
		flex: none;
		border-radius: var(--nebula-glass-radius, 16px) var(--nebula-glass-radius, 16px) 0 0;
		overflow: hidden;
		background: rgba(255, 255, 255, 0.05);
	}
	.nb-rcard__cover img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.nb-rcard__date {
		align-self: flex-start;
		padding: 0.22rem 0.65rem;
		border-radius: 999px;
		background: rgba(6, 18, 31, 0.55);
		border: 1px solid rgba(125, 211, 252, 0.35);
		color: var(--nebula-cyan, #7dd3fc);
		font: 500 0.7rem/1.4 var(--m3e-font-mono-family, monospace);
		letter-spacing: 0.05em;
	}
	.nb-rcard__date--overlay {
		position: absolute;
		left: 0.7rem;
		bottom: 0.7rem;
		backdrop-filter: blur(6px);
		-webkit-backdrop-filter: blur(6px);
	}

	.nb-rcard__title {
		margin: 0;
		font-size: 1.02rem;
		line-height: 1.4;
		font-weight: 700;
		color: var(--nebula-ink, #e7ecf7);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.nb-rcard__excerpt {
		margin: 0;
		color: var(--nebula-ink-muted, #9aa4bf);
		font-size: 0.82rem;
		line-height: 1.6;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.nb-rcard__pill {
		margin-top: auto;
		align-self: flex-start;
		padding: 0.24rem 0.72rem;
		border-radius: 999px;
		border: 1px solid rgba(125, 211, 252, 0.45);
		color: var(--nebula-cyan, #7dd3fc);
		font-size: 0.72rem;
		letter-spacing: 0.04em;
	}

	/* ── 无障碍降级：纵向列表 ─────────────────────────────────────── */
	.nb-river-fallback {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}
	.nb-river-fallback ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.nb-river-fallback li {
		padding: 0.9rem 0;
		border-bottom: 1px solid var(--nebula-glass-border, rgba(255, 255, 255, 0.12));
	}
	.nb-river-fallback a {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.6rem;
		color: var(--nebula-ink, #e7ecf7);
		text-decoration: none;
	}
	.nb-river-fallback time {
		color: var(--nebula-ink-muted, #9aa4bf);
		font: 0.78rem/1.4 var(--m3e-font-mono-family, monospace);
	}
	.nb-river-fallback__cat {
		color: var(--nebula-cyan, #7dd3fc);
		font-size: 0.75rem;
	}
	.nb-river-fallback strong {
		font-size: 1rem;
	}

	@media (prefers-reduced-motion: reduce) {
		.nb-river {
			display: none;
		}
		.nb-rcard {
			animation: none;
			transition: none;
		}
		.nb-river-particles {
			display: none;
		}
		.nb-river-fallback {
			position: static;
			width: auto;
			height: auto;
			overflow: visible;
			clip: auto;
			white-space: normal;
			display: block;
			margin-top: 1.5rem;
		}
	}
</style>
