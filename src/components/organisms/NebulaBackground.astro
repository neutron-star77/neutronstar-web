---
/**
 * NebulaBackground —— 全站星空背景（Nebula 主题复刻）。
 * 程序化生成深空星点画布（零图片资产），写入 window.__nebulaBackgroundCanvas
 * 供 LiquidGlass 渲染器采样折射。prefers-reduced-motion 时只绘静态一帧。
 */
---
<canvas id="nebula-bg" aria-hidden="true"></canvas>

<script>
  const canvas = document.getElementById('nebula-bg') as HTMLCanvasElement | null;
  if (canvas) {
    (window as any).__nebulaBackgroundCanvas = canvas;
    const ctx = canvas.getContext('2d');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let stars: { x: number; y: number; r: number; a: number; tw: number }[] = [];

    const resize = () => {
      if (!ctx) return;
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
      const count = Math.min(260, Math.floor((canvas.width * canvas.height) / 9000));
      stars = Array.from({ length: count }, () => ({
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height,
        r: Math.random() * 1.3 + 0.2,
        a: Math.random() * 0.55 + 0.2,
        tw: Math.random() * Math.PI * 2,
      }));
      draw(0);
    };

    const draw = (t: number) => {
      if (!ctx) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      for (const s of stars) {
        const alpha = reduced ? s.a : s.a * (0.72 + 0.28 * Math.sin(t / 900 + s.tw));
        ctx.fillStyle = `rgba(226, 236, 255, ${alpha.toFixed(3)})`;
        ctx.beginPath();
        ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
        ctx.fill();
      }
    };

    let raf = 0;
    const loop = (t: number) => {
      draw(t);
      raf = requestAnimationFrame(loop);
    };

    resize();
    window.addEventListener('resize', resize);
    if (!reduced) raf = requestAnimationFrame(loop);
  }
</script>
