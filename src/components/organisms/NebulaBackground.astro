---
/**
 * NebulaBackground —— 全站星云壁纸背景（Nebula 主题复刻）。
 *
 * 壁纸：JWST「宇宙悬崖」（Carina Nebula），NASA/STScI 公版（public domain），
 * 本地文件 public/images/nebula/nebula-desktop.jpg。壁纸以 cover 算法绘入
 * 全屏画布并写入 window.__nebulaBackgroundCanvas，供 LiquidGlass 渲染器
 * 采样折射（玻璃面板里能看到壁纸扭曲流动）。
 * nebula.css 在画布之上加暗色遮罩保证正文可读。
 */
---
<canvas id="nebula-bg" aria-hidden="true"></canvas>

<script>
  const canvas = document.getElementById('nebula-bg') as HTMLCanvasElement | null;
  if (canvas) {
    (window as any).__nebulaBackgroundCanvas = canvas;
    const ctx = canvas.getContext('2d');

    const WALLPAPER = '/images/nebula/nebula-desktop.jpg';
    const img = new Image();
    img.decoding = 'async';
    img.src = WALLPAPER;

    const drawCover = () => {
      if (!ctx) return;
      const w = (canvas.width = window.innerWidth);
      const h = (canvas.height = window.innerHeight);
      // 底色兜底（图片加载前/失败时）
      ctx.fillStyle = '#070a18';
      ctx.fillRect(0, 0, w, h);
      if (!img.complete || img.naturalWidth === 0) return;
      // cover 算法：等比铺满并居中裁切
      const scale = Math.max(w / img.naturalWidth, h / img.naturalHeight);
      const dw = img.naturalWidth * scale;
      const dh = img.naturalHeight * scale;
      ctx.drawImage(img, (w - dw) / 2, (h - dh) / 2, dw, dh);
    };

    img.onload = drawCover;
    window.addEventListener('resize', drawCover);
    drawCover();
  }
</script>
