---
/**
 * NebulaBackground —— 全站星云背景（Nebula 主题复刻）。
 *
 * 程序化绘制「可被折射」的绚烂星云：深空底 + 多团紫/青/玫瑰云气 + 银河带 +
 * 彩色星群。写入 window.__nebulaBackgroundCanvas 供 LiquidGlass 渲染器采样；
 * 星点缓慢闪烁（每 1.2s 被玻璃渲染器重新采样一次，折射随之流动）。
 * prefers-reduced-motion 时绘制静态一帧。
 */
---
<canvas id="nebula-bg" aria-hidden="true"></canvas>

<script>
  const canvas = document.getElementById('nebula-bg') as HTMLCanvasElement | null;
  if (canvas) {
    (window as any).__nebulaBackgroundCanvas = canvas;
    const ctx = canvas.getContext('2d');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    type Star = { x: number; y: number; r: number; a: number; tw: number; hue: string };
    let stars: Star[] = [];
    let clouds: { x: number; y: number; r: number; color: string }[] = [];
    let bandY = 0;

    const HUES = ['#e2ecff', '#cfe0ff', '#ffe9c4', '#d7ccff', '#ffd9ec'];

    const build = () => {
      if (!ctx) return;
      const w = (canvas.width = window.innerWidth);
      const h = (canvas.height = window.innerHeight);
      bandY = h * (0.3 + Math.random() * 0.15);

      // 星云云气：4-6 团大半径低透明度径向渐变（ lighter 叠加出云气感）
      clouds = [];
      const palette = [
        'rgba(109, 91, 208, 0.16)',  // violet
        'rgba(43, 111, 158, 0.15)',  // cyan-blue
        'rgba(176, 86, 138, 0.11)',  // rose
        'rgba(43, 63, 158, 0.14)',   // deep blue
        'rgba(125, 211, 252, 0.10)', // light cyan
      ];
      const n = 5;
      for (let i = 0; i < n; i++) {
        clouds.push({
          x: w * (0.12 + 0.76 * ((i + Math.random() * 0.6) / n)),
          y: h * (0.12 + Math.random() * 0.7),
          r: Math.min(w, h) * (0.28 + Math.random() * 0.3),
          color: palette[i % palette.length],
        });
      }

      // 星：总体均匀 + 沿银河带加密，部分带色
      stars = [];
      const count = Math.min(520, Math.floor((w * h) / 5200));
      for (let i = 0; i < count; i++) {
        const inBand = Math.random() < 0.45;
        const x = Math.random() * w;
        const y = inBand
          ? bandY + (Math.random() - 0.5) * h * 0.22 * (1 - Math.abs(Math.random() - 0.5) * 1.2)
          : Math.random() * h;
        stars.push({
          x, y: Math.max(0, Math.min(h, y)),
          r: Math.random() * 1.25 + 0.25,
          a: Math.random() * 0.6 + 0.25,
          tw: Math.random() * Math.PI * 2,
          hue: Math.random() < 0.82 ? '#e6eeff' : HUES[Math.floor(Math.random() * HUES.length)],
        });
      }
    };

    const paint = (t: number) => {
      if (!ctx) return;
      const w = canvas.width, h = canvas.height;
      // 深空底
      const base = ctx.createLinearGradient(0, 0, w * 0.3, h);
      base.addColorStop(0, '#0a0d20');
      base.addColorStop(0.5, '#070a18');
      base.addColorStop(1, '#04050c');
      ctx.fillStyle = base;
      ctx.fillRect(0, 0, w, h);
      // 银河带（弱光带）
      const band = ctx.createLinearGradient(0, bandY - h * 0.16, 0, bandY + h * 0.16);
      band.addColorStop(0, 'rgba(0,0,0,0)');
      band.addColorStop(0.5, 'rgba(120, 140, 220, 0.07)');
      band.addColorStop(1, 'rgba(0,0,0,0)');
      ctx.fillStyle = band;
      ctx.fillRect(0, 0, w, h);
      // 云气
      ctx.globalCompositeOperation = 'lighter';
      for (const c of clouds) {
        const g = ctx.createRadialGradient(c.x, c.y, 0, c.x, c.y, c.r);
        g.addColorStop(0, c.color);
        g.addColorStop(1, 'rgba(0,0,0,0)');
        ctx.fillStyle = g;
        ctx.fillRect(c.x - c.r, c.y - c.r, c.r * 2, c.r * 2);
      }
      ctx.globalCompositeOperation = 'source-over';
      // 星
      for (const s of stars) {
        const alpha = reduced ? s.a : s.a * (0.7 + 0.3 * Math.sin(t / 850 + s.tw));
        ctx.fillStyle = s.hue;
        ctx.globalAlpha = alpha;
        ctx.beginPath();
        ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
        ctx.fill();
        if (s.r > 1.15) {
          ctx.globalAlpha = alpha * 0.28;
          ctx.beginPath();
          ctx.arc(s.x, s.y, s.r * 3.2, 0, Math.PI * 2);
          ctx.fill();
        }
      }
      ctx.globalAlpha = 1;
    };

    let raf = 0;
    const loop = (t: number) => {
      paint(t);
      raf = requestAnimationFrame(loop);
    };

    build();
    paint(0);
    window.addEventListener('resize', () => {
      build();
      paint(0);
    });
    if (!reduced) raf = requestAnimationFrame(loop);
  }
</script>
