---
/**
 * M3 Top App Bar — 全站顶栏（Mizuki 式布局：徽标+标题置左、导航链接紧跟、
 * 右侧搜索/翻译切换/移动端菜单按钮）。
 * fixed 全宽、surface 底色 + 底部细分隔线；徽标点击回首页，
 * 菜单按钮点击派发 site-drawer:toggle 事件，由 SiteNavigationDrawer 监听开合。
 */
import IconButton from "@components/atoms/action/IconButton.svelte";
import { resolveNavBarLinks, resolvePageKey } from "@utils/nav-utils";
import { url } from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import { siteConfig } from "@/config";
import { getSiteIdentity } from "@utils/site-overrides";
import { getNavigation } from "@utils/navigation-api";
import TranslateSwitch from "./TranslateSwitch.svelte";
import Search from "./Search.svelte";

const className = Astro.props.class;
const { title: siteTitle } = await getSiteIdentity();
// P6 ⑥：导航从后台 site_config 拉取，失败回退静态配置
const links = resolveNavBarLinks(await getNavigation());
const currentPageKey = resolvePageKey(Astro.url);

function hrefFor(path?: string) {
	return path ? url(path) : undefined;
}

function isActive(link: (typeof links)[number]): boolean {
	return Boolean(
		(link.pageKey && link.pageKey === currentPageKey) ||
			link.children?.some(isActive),
	);
}
---

<div
	id="navbar"
	class:list={[
		"top-app-bar top-app-bar__glass fixed top-0 left-0 right-0 z-50 onload-animation transition",
		className,
	]}
>
	<div class="relative max-w-[var(--page-width)] mx-auto h-[4.5rem] px-3 md:px-5 flex items-center gap-1">
		{/* Mizuki 式站点徽标：图标 + 标题，点击回首页（置左，导航链接紧跟其后） */}
		<a
			href={url("/")}
			class="m3-state-layer relative flex h-10 shrink-0 items-center gap-2 rounded-lg px-2 font-bold text-[var(--on-surface)] transition-colors hover:text-[var(--primary)]"
			aria-label={siteTitle}
		>
			<img src={url("/logo/icon.webp")} alt="" class="h-7 w-7 rounded-lg object-contain" loading="lazy" />
			<span class="hidden sm:block">{siteTitle}</span>
		</a>
		<nav class:list={["top-app-bar__nav hidden h-full items-center gap-1 lg:flex", siteConfig.topAppBar.contentAlign === "center" ? "xl:absolute xl:left-1/2 xl:-translate-x-1/2" : "ml-2"]} aria-label="Main navigation">
			{/* 丝滑滑动指示器：hover/激活项之间的玻璃胶囊（位置由脚本计算，见 <script>） */}
			<span class="top-app-bar__nav-pill" data-nav-pill aria-hidden="true"></span>
			{links.map((link) => {
				const href = link.external ? link.url : hrefFor(link.url);
				const active = isActive(link);
				return (
					<div class="top-app-bar__nav-group" data-nav-group>
						{link.children ? (
							<button class:list={[
								"top-app-bar__nav-link m3-state-layer relative flex h-10 shrink-0 items-center gap-1 whitespace-nowrap px-3 text-sm font-bold text-[var(--on-surface-variant)] transition-colors hover:text-[var(--on-surface)]",
								active && "top-app-bar__nav-link--active",
							]} aria-expanded="false">
								{link.icon && <Icon name={link.icon} class="text-[1.1rem]"></Icon>}
								{link.name}
								<Icon name="material-symbols:keyboard-arrow-down-rounded" class="text-[1rem]"></Icon>
							</button>
						) : (
							<a href={href} target={link.external ? "_blank" : undefined} rel={link.external ? "noopener noreferrer" : undefined}
								aria-current={active ? "page" : undefined} data-nav-key={link.pageKey ?? ""}
								class:list={["top-app-bar__nav-link m3-state-layer relative flex h-10 shrink-0 items-center gap-1 whitespace-nowrap px-3 text-sm font-bold text-[var(--on-surface-variant)] transition-colors hover:text-[var(--on-surface)]", active && "top-app-bar__nav-link--active"]}>
								{link.icon && <Icon name={link.icon} class="text-[1.1rem]"></Icon>}{link.name}
								{link.external && <Icon name="material-symbols:arrow-outward-rounded" class="ml-1 text-[0.875rem]"></Icon>}
							</a>
						)}
						{link.children && <div class="top-app-bar__submenu" role="menu">
							{link.children.map((child) => {
								const childHref = child.external ? child.url : hrefFor(child.url);
							return <a href={childHref} target={child.external ? "_blank" : undefined} rel={child.external ? "noopener noreferrer" : undefined} role="menuitem" data-nav-key={child.pageKey ?? ""} class="top-app-bar__submenu-item">
									{child.icon && <Icon name={child.icon} class="text-[1.2rem]"></Icon>}{child.name}{child.external && <Icon name="material-symbols:arrow-outward-rounded" class="ml-auto text-[0.875rem]"></Icon>}
								</a>;
							})}
						</div>}
					</div>
				);
			})}
		</nav>
		<div class="flex-1"></div>
		<div class="flex items-center gap-1.5 md:gap-2 shrink-0">
			<Search client:only="svelte"></Search>
			<TranslateSwitch client:only="svelte"></TranslateSwitch>
			<IconButton id="nav-drawer-switch" label="Menu" class="shrink-0 lg:!hidden">
				<Icon name="material-symbols:menu-rounded" class="text-[1.25rem]"></Icon>
			</IconButton>
		</div>
	</div>
</div>

<script>
	import { resolvePageKey } from "@utils/nav-utils";

	/** 滑动指示器的定位目标：下拉组或普通链接 */
	const NAV_TARGET_SELECTOR = "[data-nav-group], a[data-nav-key]";

	function navPillElements() {
		const nav = document.querySelector<HTMLElement>("#navbar .top-app-bar__nav");
		const pill = nav?.querySelector<HTMLElement>("[data-nav-pill]");
		return { nav, pill };
	}

	/** 当前激活项（含下拉子菜单命中的组），作为 hover 离开后的回位目标 */
	function findActiveNavTarget(): HTMLElement | null {
		const { nav } = navPillElements();
		if (!nav) return null;
		for (const el of nav.querySelectorAll<HTMLElement>(NAV_TARGET_SELECTOR)) {
			if (el.classList.contains("top-app-bar__nav-link--active") || el.querySelector(".top-app-bar__nav-link--active")) {
				return el;
			}
		}
		return null;
	}

	/**
	 * 把胶囊高亮层移动到 target 的位置与尺寸（transform + width 过渡）。
	 * instant=true 跳过动画（首帧/resize/reduced-motion）；导航隐藏或目标不可见时只淡出。
	 */
	function moveNavPill(target: HTMLElement | null, instant = false) {
		const { nav, pill } = navPillElements();
		if (!nav || !pill) return;
		if (instant || pill.classList.contains("top-app-bar__nav-pill--no-motion")) {
			pill.classList.add("top-app-bar__nav-pill--instant");
		}
		const navRect = nav.getBoundingClientRect();
		const rect = target?.getBoundingClientRect();
		if (!target || !rect || nav.offsetWidth === 0 || rect.width === 0) {
			pill.style.opacity = "0";
		} else {
			pill.style.width = `${Math.round(rect.width)}px`;
			pill.style.height = `${Math.round(rect.height)}px`;
			pill.style.transform = `translate(${Math.round(rect.left - navRect.left)}px, ${Math.round(rect.top - navRect.top)}px)`;
			pill.style.opacity = "1";
		}
		if (instant) {
			requestAnimationFrame(() => pill.classList.remove("top-app-bar__nav-pill--instant"));
		}
	}

	/** 胶囊指示器事件绑定（只绑一次；hover/focus 跟随、离场回位、resize 重算、reduced-motion 跳变） */
	function initNavPill() {
		const { nav, pill } = navPillElements();
		if (!nav || !pill || document.documentElement.dataset.navPillBound) return;
		document.documentElement.dataset.navPillBound = "true";

		let hovered: HTMLElement | null = null;
		const settle = (instant = false) => moveNavPill(hovered ?? findActiveNavTarget(), instant);

		nav.addEventListener("mouseover", (event) => {
			const target = (event.target as HTMLElement | null)?.closest<HTMLElement>(NAV_TARGET_SELECTOR);
			if (target && nav.contains(target)) {
				hovered = target;
				moveNavPill(target);
			}
		});
		// hover 离开菜单区域 → 滑回当前激活项
		nav.addEventListener("mouseleave", () => {
			hovered = null;
			moveNavPill(findActiveNavTarget());
		});
		// 键盘可达：Tab 聚焦导航项时指示器同步跟随
		nav.addEventListener("focusin", (event) => {
			const target = (event.target as HTMLElement | null)?.closest<HTMLElement>(NAV_TARGET_SELECTOR);
			if (target) moveNavPill(target);
		});
		nav.addEventListener("focusout", (event) => {
			if (!nav.contains(event.relatedTarget as Node)) moveNavPill(findActiveNavTarget());
		});
		// resize 时按当前目标（hover 优先，否则激活项）即时重算位置
		window.addEventListener("resize", () => settle(true));

		// prefers-reduced-motion：彻底去掉过渡，直接跳变
		const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
		const applyMotionPreference = () => {
			pill.classList.toggle("top-app-bar__nav-pill--no-motion", reduceMotion.matches);
			settle(true);
		};
		reduceMotion.addEventListener("change", applyMotionPreference);
		applyMotionPreference();

		// 首帧定位（避免从原点飞入）；字体加载完成后宽度可能变化，重算一次
		moveNavPill(findActiveNavTarget(), true);
		document.fonts?.ready.then(() => settle(true)).catch(() => {});
	}

	function syncTopAppBarNavigation(instant = false) {
		setTopAppBarNavigation(resolvePageKey(new URL(window.location.href)));
		moveNavPill(findActiveNavTarget(), instant);
	}

	function setTopAppBarNavigation(pageKey: string) {
		document.querySelectorAll<HTMLElement>("[data-nav-key]").forEach((link) => {
			const active = (link.dataset.navKey || "") === pageKey;
			link.classList.toggle("top-app-bar__nav-link--active", active);
			if (active) link.setAttribute("aria-current", "page");
			else link.removeAttribute("aria-current");
		});
		document.querySelectorAll<HTMLElement>("[data-nav-group]").forEach((group) => {
			// 仅处理有下拉子菜单的组（组触发器是 button）；普通链接组已由上面设置
			const trigger = group.querySelector(":scope > button.top-app-bar__nav-link");
			if (!trigger) return;
			const active = Boolean(group.querySelector(".top-app-bar__submenu-item.top-app-bar__nav-link--active"));
			trigger.classList.toggle("top-app-bar__nav-link--active", active);
		});
	}

	function closeTopAppBarMenus() {
		document.querySelectorAll<HTMLElement>("[data-nav-group].top-app-bar__nav-group--open").forEach((group) => {
			group.classList.remove("top-app-bar__nav-group--open");
			group.querySelector(":scope > button")?.setAttribute("aria-expanded", "false");
		});
	}

	function loadTopAppBar() {
		const drawerBtn = document.getElementById("nav-drawer-switch");
		if (drawerBtn) {
			drawerBtn.onclick = () => {
				document.dispatchEvent(new CustomEvent("site-drawer:toggle"));
			};
		}

		// 滚动方向检测：向下滚隐藏顶栏、向上滚保持隐藏，
		// 只有滚回距顶部 TOP_REVEAL 以内才重新唤回（页面顶部永远显示，避免刚进来就被藏掉）。
		const nav = document.getElementById("navbar");
		if (nav && !document.documentElement.dataset.topBarHideBound) {
			document.documentElement.dataset.topBarHideBound = "true";
			let lastY = window.scrollY;
			let raf = 0;
			const HIDE_DELTA = 6;
			const TOP_REVEAL = 120;
			const apply = () => {
				raf = 0;
				const y = window.scrollY;
				const goingDown = y > lastY + HIDE_DELTA;
				if (y < TOP_REVEAL) nav.classList.remove("navbar-hidden");
				else if (goingDown) nav.classList.add("navbar-hidden");
				lastY = y;
			};
			window.addEventListener(
				"scroll",
				() => {
					if (raf) return;
					raf = requestAnimationFrame(apply);
				},
				{ passive: true },
			);
			// swup 换页后回到顶部，顶栏复位显示
			document.addEventListener("swup:page:view", () => {
				lastY = 0;
				nav.classList.remove("navbar-hidden");
			});
		}

		initNavPill();

		syncTopAppBarNavigation(true);
		document.querySelectorAll<HTMLElement>("[data-nav-key]").forEach((link) => {
			link.onclick = () => {
				setTopAppBarNavigation(link.dataset.navKey || "");
				moveNavPill(findActiveNavTarget());
				closeTopAppBarMenus();
			};
		});
		document.querySelectorAll<HTMLElement>("[data-nav-group]").forEach((group) => {
			const trigger = group.querySelector<HTMLButtonElement>(":scope > button");
			if (!trigger) return;
			trigger.onclick = () => {
				const open = group.classList.toggle("top-app-bar__nav-group--open");
				trigger.setAttribute("aria-expanded", String(open));
			};
		});
		if (!document.documentElement.dataset.topAppBarNavBound) {
			document.documentElement.dataset.topAppBarNavBound = "true";
			document.addEventListener("swup:content:replace", () => syncTopAppBarNavigation());
			document.addEventListener("swup:page:view", () => syncTopAppBarNavigation());
			document.addEventListener("click", (event) => {
				const insideNavigationGroup = event.composedPath().some(
					(node) => node instanceof HTMLElement && node.hasAttribute("data-nav-group"),
				);
				if (!insideNavigationGroup) {
					closeTopAppBarMenus();
				}
			});
			document.addEventListener("keydown", (event) => {
				if (event.key === "Escape") closeTopAppBarMenus();
			});
			window.addEventListener("popstate", () => syncTopAppBarNavigation());
		}
	}

	loadTopAppBar();
</script>

{import.meta.env.PROD && <script is:inline define:vars={{scriptUrl: url('/pagefind/pagefind.js')}}>
window.__loadPagefind = function() {
	if (window.__pagefindLoadingPromise) return window.__pagefindLoadingPromise;
	window.__pagefindLoadingPromise = (async () => {
		try {
			const pagefind = await import(scriptUrl);
			await pagefind.options({
				excerptLength: 20
			});
			window.pagefind = pagefind;
			document.dispatchEvent(new CustomEvent('pagefindready'));
			return pagefind;
		} catch (error) {
			console.error('Failed to load Pagefind:', error);
			window.pagefind = {
				search: () => Promise.resolve({ results: [] }),
				options: () => Promise.resolve(),
			};
			document.dispatchEvent(new CustomEvent('pagefindloaderror'));
			return window.pagefind;
		}
	})();
	return window.__pagefindLoadingPromise;
};

function bindSearchTriggers() {
	const triggers = [
		document.getElementById('search-input-desktop'),
		document.getElementById('search-switch')
	];
	for (const el of triggers) {
		if (!el) continue;
		if (el.dataset.pagefindBound === 'true') continue;
		el.dataset.pagefindBound = 'true';
		el.addEventListener('focus', window.__loadPagefind, { once: true, passive: true });
		el.addEventListener('click', window.__loadPagefind, { once: true, passive: true });
	}
}

if (document.readyState === 'loading') {
	document.addEventListener('DOMContentLoaded', bindSearchTriggers, { once: true });
} else {
	bindSearchTriggers();
}
document.addEventListener('swup:content:replace', bindSearchTriggers);
</script>}

<style>
	/* 背景透明统一：导航栏胶囊 = 透明玻璃（--nebula-* 令牌优先，回退同值） */
	.top-app-bar__glass {
		background: var(--nebula-glass-fill, rgba(255, 255, 255, 0.08));
		border: 1px solid var(--nebula-glass-border, rgba(255, 255, 255, 0.12));
		border-radius: 999px;
		backdrop-filter: blur(var(--nebula-glass-blur, 12px)) saturate(1.3);
		-webkit-backdrop-filter: blur(var(--nebula-glass-blur, 12px)) saturate(1.3);
	}

	/* ── 丝滑滑动指示器：hover/激活项之间的玻璃胶囊 ─────────────────
	 * 位置与尺寸由脚本（moveNavPill）写入，这里只负责过渡曲线与外观。
	 * DOM 上位于链接之前 + 链接自带 relative，胶囊始终垫在文字下层。 */
	.top-app-bar__nav {
		position: relative;
	}

	.top-app-bar__nav-pill {
		position: absolute;
		top: 0;
		left: 0;
		width: 0;
		height: 0;
		border-radius: 20px;
		background: color-mix(in oklab, var(--nebula-ink, #e7ecf7) 12%, transparent);
		border: 1px solid var(--nebula-glass-border, rgba(255, 255, 255, 0.12));
		opacity: 0;
		pointer-events: none;
		transition:
			transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
			width 0.4s cubic-bezier(0.22, 1, 0.36, 1),
			height 0.4s cubic-bezier(0.22, 1, 0.36, 1),
			opacity 0.15s linear;
		will-change: transform, width;
	}

	/* 首帧定位 / resize / reduced-motion：跳过过渡直接落位 */
	.top-app-bar__nav-pill--instant {
		transition: none;
	}

	.top-app-bar {
		transition:
			transform 0.25s var(--m3e-easing-emphasized-accelerate),
			background-color var(--m3e-duration-medium) var(--m3e-easing-standard),
			box-shadow var(--m3e-duration-medium) var(--m3e-easing-standard),
			color var(--m3e-duration-short) var(--m3e-easing-standard);
	}

	/* 向下滚动自动隐藏、向上滚动立即唤回（见 <script> 里的方向判定） */
	.top-app-bar.navbar-hidden {
		transform: translateY(-100%);
	}

	@media (prefers-reduced-motion: reduce) {
		.top-app-bar,
		.top-app-bar__nav-pill {
			transition: none;
		}
	}

		.top-app-bar--transparent {
			background: transparent;
			box-shadow: none;
			backdrop-filter: none;
			color: white;
			--on-surface: white;
			--on-surface-variant: rgba(255, 255, 255, 0.9);
			--primary: white;
		}

			:global(.top-app-bar--transparent .top-app-bar__search-shell--expanded) {
				--on-surface: var(--mc-on-surface);
				--on-surface-variant: var(--mc-on-surface-variant);
				--primary: var(--mc-primary);
				color: var(--mc-on-surface);
			}

			:global(.top-app-bar--transparent .top-app-bar__search-shell--expanded input) {
				color: var(--mc-on-surface) !important;
				caret-color: var(--mc-primary) !important;
			}

			:global(.top-app-bar--transparent .top-app-bar__search-shell--expanded svg) {
				color: var(--mc-on-surface-variant) !important;
			}

			/* Floating surfaces keep their theme foreground instead of inheriting
		 * the white chrome used by the transparent app bar. */
		:global(.top-app-bar--transparent .float-panel),
		:global(.top-app-bar--transparent .m3-menu),
		:global(.top-app-bar--transparent .top-app-bar__submenu) {
			--on-surface: var(--mc-on-surface);
			--on-surface-variant: var(--mc-on-surface-variant);
			--primary: var(--mc-primary);
			color: var(--mc-on-surface);
		}

		.top-app-bar--transparent .top-app-bar__nav-link--active::after {
		background: white;
	}

	.top-app-bar__nav-link--active {
		color: var(--primary);
	}

	.top-app-bar__nav-link--active::after {
		content: "";
		position: absolute;
		inset-inline: 0.75rem;
		bottom: 0;
		height: 3px;
		border-radius: var(--shape-corner-full);
		background: var(--primary);
	}

	.top-app-bar__nav-group {
		position: relative;
	}

	/* Twilight 式即时悬停：鼠标移入立刻展开、移出立刻收回，不留可见延迟。
	   - visibility 不参与 transition（离散属性，立即切换）；
	   - opacity 仅 80ms 淡入，离开时同步隐藏；
	   - 用透明 padding-top 桥接 trigger 与面板之间的视觉间隙，鼠标斜向移入面板不会断 hover。 */
	.top-app-bar__submenu {
		position: absolute;
		top: 100%;
		left: 0;
		min-width: 12rem;
		padding: 0.5rem 0.375rem 0.375rem;
		margin-top: -0.5rem;
		border-radius: var(--shape-corner-l);
		background: var(--nebula-glass-fill, var(--surface-container));
		border: 1px solid var(--nebula-glass-border, transparent);
		backdrop-filter: blur(var(--nebula-glass-blur, 12px)) saturate(1.3);
		-webkit-backdrop-filter: blur(var(--nebula-glass-blur, 12px)) saturate(1.3);
		box-shadow: var(--m3e-elevation-2);
		opacity: 0;
		visibility: hidden;
		transform: translateY(-0.125rem);
		transform-origin: top left;
		transition: opacity 80ms linear, transform 80ms linear;
		pointer-events: none;
	}

	.top-app-bar__nav-group:hover > .top-app-bar__submenu,
	.top-app-bar__nav-group:focus-within > .top-app-bar__submenu,
	.top-app-bar__nav-group--open > .top-app-bar__submenu {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
		pointer-events: auto;
	}

	.top-app-bar__submenu-item {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		min-height: 2.75rem;
		padding: 0 0.875rem;
		border-radius: var(--shape-corner-m);
		color: var(--on-surface);
		font: var(--m3e-type-label-large);
		text-decoration: none;
	}

	.top-app-bar__submenu-item:hover,
	.top-app-bar__submenu-item:focus-visible {
		background: color-mix(in oklab, var(--on-surface) 8%, transparent);
		outline: none;
	}

	.top-app-bar__submenu-item.top-app-bar__nav-link--active {
		background: var(--secondary-container);
		color: var(--on-secondary-container);
	}

	.top-app-bar__submenu-item.top-app-bar__nav-link--active::after {
		display: none;
	}
</style>
