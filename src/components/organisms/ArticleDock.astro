---
/**
 * ArticleDock —— 文章底部流光图标栏（2026-10-26，参考 kombai 流光溢彩风）。
 *
 * 四枚圆玻璃图标：返回列表 / 分享（唤起 ArticleShare 海报弹窗）/ 赞赏（悬停弹双码大图）/ RSS。
 * 流光：conic-gradient 旋转描边 + 内辉光呼吸 + hover 悬浮加速；赞赏弹层纯 CSS hover。
 */
import { GLYPHS } from "@utils/glyphs";
const glyph = (n: string) => GLYPHS[n] ?? GLYPHS.spark;
---

<div class="article-dock" aria-label="文章工具栏">
    <a class="dock-btn" href="/" title="返回文章列表" aria-label="返回文章列表">
        <span class="dock-glyph" set:html={glyph("back")} />
        <span class="dock-tip">返回列表</span>
    </a>
    <button class="dock-btn" type="button" title="分享文章" aria-label="分享文章"
        onclick="window.dispatchEvent(new CustomEvent('dock:share'))">
        <span class="dock-glyph" set:html={glyph("share")} />
        <span class="dock-tip">分享文章</span>
    </button>
    <div class="dock-btn dock-tip-host" tabindex="0" title="赞赏" aria-label="赞赏支持">
        <span class="dock-glyph" set:html={glyph("gift")} />
        <span class="dock-tip">赞赏</span>
        <div class="dock-reward" role="tooltip">
            <div class="dock-reward__item">
                <img src="/images/tip/alipay.png" alt="支付宝赞赏码" loading="lazy" />
                <span>支付宝</span>
            </div>
            <div class="dock-reward__item">
                <img src="/images/tip/wechat.png" alt="微信赞赏码" loading="lazy" />
                <span>微信</span>
            </div>
        </div>
    </div>
    <a class="dock-btn" href="/rss.xml" title="RSS 订阅" aria-label="RSS 订阅">
        <span class="dock-glyph" set:html={glyph("rss")} />
        <span class="dock-tip">RSS</span>
    </a>
</div>

<style>
    .article-dock {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 1.4rem;
        margin: 2rem auto 1rem;
        padding: 0.8rem 1.4rem;
        width: fit-content;
        max-width: 100%;
    }

    /* ── 流光圆玻璃按钮：旋转 conic 描边 + 内辉光 ─────────────── */
    .dock-btn {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 3rem;
        height: 3rem;
        border-radius: 999px;
        border: 0;
        background:
            linear-gradient(rgba(10, 14, 28, 0.72), rgba(10, 14, 28, 0.72))
            padding-box,
            conic-gradient(
                from var(--dock-angle, 0deg),
                #7dd3fc,
                #a78bfa,
                #f0abfc,
                #7dd3fc
            )
            border-box;
        border: 1.5px solid transparent;
        backdrop-filter: blur(10px) saturate(1.3);
        -webkit-backdrop-filter: blur(10px) saturate(1.3);
        box-shadow:
            0 0 0 1px rgba(255, 255, 255, 0.06),
            0 6px 18px rgba(0, 0, 0, 0.35),
            0 0 16px rgba(125, 211, 252, 0.12);
        cursor: pointer;
        text-decoration: none;
        transition:
            transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1),
            box-shadow 0.35s ease;
        animation: dock-border-flow 6s linear infinite;
    }
    .dock-btn:nth-child(2) { animation-delay: -2s; }
    .dock-btn:nth-child(3) { animation-delay: -4s; }
    .dock-btn:nth-child(4) { animation-delay: -1s; }

    @property --dock-angle {
        syntax: "<angle>";
        initial-value: 0deg;
        inherits: false;
    }
    @keyframes dock-border-flow {
        to { --dock-angle: 360deg; }
    }

    .dock-btn:hover,
    .dock-btn:focus-visible {
        transform: translateY(-4px) scale(1.08);
        box-shadow:
            0 0 0 1px rgba(255, 255, 255, 0.1),
            0 10px 26px rgba(0, 0, 0, 0.4),
            0 0 26px rgba(167, 139, 250, 0.35);
        outline: none;
    }

    .dock-glyph {
        display: inline-flex;
        width: 1.45rem;
        height: 1.45rem;
        color: #e7ecf7;
        filter: drop-shadow(0 0 5px rgba(125, 211, 252, 0.45));
        transition: color 0.25s ease, filter 0.25s ease;
    }
    .dock-glyph :global(svg) { width: 100%; height: 100%; }
    .dock-btn:hover .dock-glyph {
        color: #7dd3fc;
        filter: drop-shadow(0 0 8px rgba(125, 211, 252, 0.85));
    }

    /* 悬停小标签（赞赏弹层宿主除外） */
    .dock-tip {
        position: absolute;
        bottom: -1.9rem;
        left: 50%;
        transform: translateX(-50%) translateY(4px);
        white-space: nowrap;
        font-size: 0.68rem;
        letter-spacing: 0.05em;
        color: #9aa4bf;
        opacity: 0;
        transition: opacity 0.2s ease, transform 0.2s ease;
        pointer-events: none;
    }
    .dock-btn:hover .dock-tip {
        opacity: 1;
        transform: translateX(-50%) translateY(0);
    }
    .dock-tip-host .dock-tip { display: none; }

    /* ── 赞赏弹层：悬停浮现双码大图 ─────────────────────────── */
    .dock-reward {
        position: absolute;
        bottom: calc(100% + 0.9rem);
        left: 50%;
        transform: translateX(-50%) translateY(8px) scale(0.96);
        display: flex;
        gap: 1rem;
        padding: 1rem 1.1rem 0.8rem;
        border-radius: 18px;
        background: rgba(10, 14, 28, 0.88);
        border: 1px solid rgba(167, 139, 250, 0.35);
        backdrop-filter: blur(16px) saturate(1.3);
        -webkit-backdrop-filter: blur(16px) saturate(1.3);
        box-shadow:
            0 18px 46px rgba(0, 0, 0, 0.5),
            0 0 30px rgba(167, 139, 250, 0.18);
        opacity: 0;
        visibility: hidden;
        transition:
            opacity 0.28s ease,
            transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1),
            visibility 0.28s;
        pointer-events: none;
        z-index: 60;
    }
    .dock-tip-host:hover .dock-reward,
    .dock-tip-host:focus-within .dock-reward {
        opacity: 1;
        visibility: visible;
        transform: translateX(-50%) translateY(0) scale(1);
    }
    .dock-reward__item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.45rem;
    }
    .dock-reward__item img {
        width: 9.5rem;
        height: auto;
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.14);
    }
    .dock-reward__item span {
        font-size: 0.75rem;
        color: #cdd6ea;
        letter-spacing: 0.12em;
    }

    @media (prefers-reduced-motion: reduce) {
        .dock-btn { animation: none; transition: none; }
        .dock-btn:hover { transform: none; }
    }
</style>
