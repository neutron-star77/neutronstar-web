---
import FloatingActionButton from "@components/molecules/FloatingActionButton.astro";
import FloatingTOCPanel from "@components/molecules/FloatingTOCPanel.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { resolveDeviceClasses } from "@utils/fab-responsive";
import { isWidgetVisibleOnPage } from "@utils/sidebar-page";
import type { MarkdownHeading } from "astro";
import { Icon } from "astro-icon/components";
/**
 * FloatingControls.astro
 * 右下角悬浮控制流有机体：统领全站 FAB 导航项、响应式设备适配与 Swup 生命周期。
 * 严格遵循【零额外负担】原则：评论系统未启用或当前文章禁用评论时，不输出评论按钮。
 */
import { commentConfig, fabConfig, resolveCommentOptions } from "@/config";
import { BANNER_HEIGHT } from "@/constants/constants";
import type { SidebarPage } from "@/types/sidebarConfig";

interface Props {
	headings?: MarkdownHeading[];
	page?: SidebarPage;
	hasComments?: boolean;
}

const { headings = [], page, hasComments } = Astro.props;

if (!fabConfig.enable) {
	return null;
}

const enabledItems = fabConfig.items.filter((item) => item.enable);
const tocItem = enabledItems.find((i) => i.type === "toc");
const commentItem = enabledItems.find((i) => i.type === "comment");
const homeItem = enabledItems.find((i) => i.type === "home");
const topItem = enabledItems.find((i) => i.type === "top");

// 零额外负担：全局评论系统未启用或未配置时，不渲染评论 FAB 按钮
const isCommentSystemEnabled = Boolean(resolveCommentOptions(commentConfig));
const isCommentActiveOnPage = isCommentSystemEnabled && (hasComments ?? false);
const isHomeItemVisible = homeItem
	? isWidgetVisibleOnPage(homeItem.pages, page) &&
		(!homeItem.onlySubPages || page !== "home")
	: false;
---

<aside
	id="floating-controls"
	aria-label={i18n(I18nKey.more)}
	class:list={[
		"m3-floating-controls-container",
		{ "m3-floating-controls-container--start": fabConfig.align === "start" },
	]}
	data-banner-height={BANNER_HEIGHT}
	style={`--fab-bottom: ${fabConfig.offset?.bottom ?? "var(--m3e-space-8)"}; --fab-inline-offset: ${fabConfig.offset?.right ?? "var(--m3e-space-6)"}`}
>
	<!-- 1. TOC 悬浮目录项与弹窗 -->
	{tocItem && (
		<div
			data-fab-slot
			class:list={[
				"relative",
				resolveDeviceClasses(tocItem.devices),
				{ "is-page-hidden": !isWidgetVisibleOnPage(tocItem.pages, page) },
			]}
		>
			<FloatingTOCPanel
				headings={headings}
				maxDepth={tocItem.depth}
				closeOnSelect={tocItem.closeOnSelect}
			/>
			<FloatingActionButton
				id="fab-toc-btn"
				type="toc"
				ariaLabel={i18n(I18nKey.tableOfContents)}
				devices={tocItem.devices}
				pages={tocItem.pages ?? ["post"]}
				size={fabConfig.size}
				class={!isWidgetVisibleOnPage(tocItem.pages, page) ? "is-page-hidden" : ""}
			>
				<Icon name="material-symbols:format-list-bulleted-rounded" class="text-xl" />
			</FloatingActionButton>
		</div>
	)}

	<!-- 2. 直达评论区：仅当站点已启用评论系统时渲染 -->
	{commentItem && isCommentSystemEnabled && (
		<FloatingActionButton
			id="fab-comment-btn"
			type="comment"
			ariaLabel={i18n(I18nKey.backToComment)}
			devices={commentItem.devices}
			pages={commentItem.pages ?? ["post"]}
			size={fabConfig.size}
			targetSelector={commentItem.targetSelector}
			class={(!isWidgetVisibleOnPage(commentItem.pages, page) || !isCommentActiveOnPage) ? "is-page-hidden" : ""}
			onclick="window.__shironeFab?.scrollToComment()"
		>
			<Icon name="material-symbols:chat-bubble-outline-rounded" class="text-xl" />
		</FloatingActionButton>
	)}

	<!-- 3. 返回首页 -->
	{homeItem && (
		<FloatingActionButton
			id="fab-home-btn"
			type="home"
			ariaLabel={i18n(I18nKey.backToHome)}
			devices={homeItem.devices}
			pages={homeItem.pages}
			size={fabConfig.size}
			onlySubPages={homeItem.onlySubPages}
			class={!isHomeItemVisible ? "is-page-hidden" : ""}
			onclick="window.__shironeFab?.navigateToHome()"
		>
			<Icon name="material-symbols:home-outline-rounded" class="text-xl" />
		</FloatingActionButton>
	)}

	<!-- 4. 返回顶部：绳子吊小动物趣味样式（原创 SVG，主题色自适应；点击播放收绳动画后平滑回顶） -->
	{topItem && (
		<FloatingActionButton
			id="fab-top-btn"
			type="top"
			ariaLabel={i18n(I18nKey.backToTop)}
			devices={topItem.devices}
			pages={topItem.pages}
			size={fabConfig.size}
			thresholdRatio={topItem.scrollThresholdRatio}
			class:list={["fab-top-doodle", "is-hidden", { "is-page-hidden": !isWidgetVisibleOnPage(topItem.pages, page) }]}
			onclick="window.__shironeFab?.scrollToTop()"
		>
			<svg
				class="fab-top-doodle-svg"
				width="48"
				height="88"
				viewBox="0 0 56 104"
				fill="none"
				aria-hidden="true"
				xmlns="http://www.w3.org/2000/svg"
			>
				<!-- 顶端挂环（摆动支点） -->
				<circle cx="28" cy="9" r="5" stroke="var(--primary)" stroke-width="3" />
				<!-- 绳子 -->
				<path
					class="fab-top-doodle-rope"
					d="M28 14 C26 26, 30 38, 28 52"
					stroke="var(--primary)"
					stroke-opacity="0.72"
					stroke-width="3"
					stroke-linecap="round"
				/>
				<!-- 绳结 -->
				<ellipse cx="28" cy="53.5" rx="3.5" ry="2.5" fill="var(--primary)" />
				<!-- 小狐狸（吊在绳下） -->
				<g class="fab-top-doodle-animal">
					<!-- 左耳 + 内耳 -->
					<path d="M15.5 69 L20 50 L27.5 65 Z" fill="var(--primary)" />
					<path d="M18.5 65 L21 56 L24.5 65 Z" fill="var(--tertiary)" />
					<!-- 右耳 + 内耳 -->
					<path d="M40.5 69 L36 50 L28.5 65 Z" fill="var(--primary)" />
					<path d="M37.5 65 L35 56 L31.5 65 Z" fill="var(--tertiary)" />
					<!-- 小爪（抓绳） -->
					<path
						d="M24.5 63 C26 58.5, 27.5 58, 28 61.5 M31.5 63 C30 58.5, 28.5 58, 28 61.5"
						stroke="var(--on-primary-container)"
						stroke-width="2"
						stroke-linecap="round"
					/>
					<!-- 头部 -->
					<ellipse cx="28" cy="82" rx="17" ry="14.5" fill="var(--primary)" />
					<!-- 眼睛 -->
					<circle cx="22" cy="80" r="1.9" fill="var(--on-primary-container)" />
					<circle cx="34" cy="80" r="1.9" fill="var(--on-primary-container)" />
					<!-- 鼻子 -->
					<circle cx="28" cy="85" r="1.7" fill="var(--tertiary)" />
					<!-- 微笑 -->
					<path
						d="M25.2 88.5 Q28 91.3 30.8 88.5"
						stroke="var(--on-primary-container)"
						stroke-width="1.6"
						stroke-linecap="round"
					/>
					<!-- 腮红 -->
					<circle cx="17.5" cy="85" r="2.4" fill="var(--tertiary)" fill-opacity="0.45" />
					<circle cx="38.5" cy="85" r="2.4" fill="var(--tertiary)" fill-opacity="0.45" />
				</g>
			</svg>
		</FloatingActionButton>
	)}
</aside>

<style lang="stylus">
.m3-floating-controls-container
	position: fixed
	right: var(--fab-inline-offset)
	bottom: var(--fab-bottom)
	z-index: 45
	display: flex
	flex-direction: column
	align-items: flex-end
	gap: 0.625rem
	pointer-events: none

	&--start
		right: auto
		left: var(--fab-inline-offset)

/* === 回顶按钮「绳子吊小动物」趣味样式 ===
   沿用 FloatingActionButton 的显隐/滚动阈值逻辑，仅把 M3 FAB 外壳透明化，
   换上原创吊挂 SVG：绳顶挂环为摆动支点，绳下吊小狐狸；
   hover 时小动物轻跳示意可交互，点击播放「收绳」动画（见下方 <script>）。 */
:global(.fab-top-doodle .m3-fab)
	width: 3.5rem
	height: 6.5rem /* 104px 容纳吊挂 SVG */
	background: transparent
	box-shadow: none
	border-radius: 0
	--m3e-state-color: transparent /* 取消 hover/focus 涟漪，避免透明底残留底色 */

:global(.fab-top-doodle .m3-fab:focus-visible)
	outline: 2px solid var(--primary)
	outline-offset: 2px

:global(.fab-top-doodle-svg)
	width: 3rem /* 48px */
	height: 5.5rem /* 88px */
	transform-origin: 50% 12% /* 挂环为支点 */
	animation: m3e-fab-doodle-sway 3.6s ease-in-out infinite

:global(.fab-top-doodle:hover .fab-top-doodle-svg)
	animation-duration: 1.5s /* hover 加快摆动以表可交互 */

:global(.fab-top-doodle .fab-top-doodle-animal)
	transition: transform var(--m3e-duration-short) var(--m3e-easing-emphasized-decelerate)

:global(.fab-top-doodle:hover .fab-top-doodle-animal)
	transform: translateY(-0.1875rem)

/* 点击收绳：绳子缩回 + 小动物被拉向顶部（由下方事件委托添加 .is-reeling） */
:global(.fab-top-doodle.is-reeling .fab-top-doodle-rope)
	transform: scaleY(0)
	transform-origin: 50% 8%
	transition: transform 0.22s var(--m3e-easing-emphasized-accelerate)

:global(.fab-top-doodle.is-reeling .fab-top-doodle-animal)
	transform: translateY(-2.5rem) scale(0.5)
	opacity: 0
	transition:
		transform 0.24s var(--m3e-easing-emphasized-accelerate),
		opacity 0.18s var(--m3e-easing-standard)

@keyframes m3e-fab-doodle-sway
	0%, 100%
		transform: rotate(-5deg)
	50%
		transform: rotate(5deg)

@media (prefers-reduced-motion: reduce)
	:global(.fab-top-doodle-svg)
		animation: none
</style>

<script>
	import { initFabController } from "@utils/fab-controller";
	import { prefersReducedMotion } from "@utils/motion";

	// 初始化 FAB 运行时状态机，支持直接加载与 Swup 导航
	if (typeof window !== "undefined") {
		initFabController();
	}

	// 回顶按钮「收绳」趣味动画：点击时绳子缩回、小动物被拉向顶部，
	// 滚动动作由 __shironeFab.scrollToTop() 负责；用事件委托避免 Swup 重建丢失绑定。
	document.addEventListener("click", (e) => {
		const btn = (e.target as HTMLElement).closest<HTMLElement>("#fab-top-btn");
		if (!btn || prefersReducedMotion()) return;
		btn.classList.remove("is-reeling");
		void btn.offsetHeight; // 强制 reflow，保证重复点击可重放动画
		btn.classList.add("is-reeling");
		window.setTimeout(() => btn.classList.remove("is-reeling"), 700);
	});
</script>
