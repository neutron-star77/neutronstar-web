---
import MainGridLayout from "../layouts/MainGridLayout.astro";
import MessagesList from "@components/islands/MessagesList";

// 杂谈页静态壳 + MessagesList island（客户端 SWR 拉取 /api/messages）
// P4 实时：新杂谈/留言入库 → SSE 自动重拉（见 MessagesList 内 useRealtimeRefresh）
---

<MainGridLayout title="杂谈" description="碎碎念与留言板" page="messages">
    <div class="card-base onload-animation mb-4 rounded-m3 bg-surface-container px-5 py-4">
        <p class="text-sm leading-6 text-on-surface-variant">
            杂谈是留言板 —— 想说点什么就来这里留一句。内容会实时展示在下方。
        </p>
    </div>
    <MessagesList client:load />
</MainGridLayout>