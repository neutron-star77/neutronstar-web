---
import MainGridLayout from "../layouts/MainGridLayout.astro";
import WalineComments from "@components/islands/WalineComments";

// 留言板：整页就是一个 Waline 评论线程（path=/messages），允许匿名留言。
---

<MainGridLayout title="杂谈" description="碎碎念与留言板" page="messages">
    <div class="card-base onload-animation mb-4 rounded-m3 bg-surface-container px-5 py-4">
        <p class="text-sm leading-6 text-on-surface-variant">
            杂谈是留言板 —— 想说点什么就来这里留一句，支持匿名或使用 GitHub 登录。
        </p>
    </div>
    <WalineComments client:load path="/messages" title="留言板" />
</MainGridLayout>