---
import Page from "../layouts/Page.astro";
import HomeFeed from "../components/islands/HomeFeed.tsx";
import { site } from "../config/site";
---

<Page title={site.name} description={site.description}>
  {/* Hero：纯 Astro 静态渲染，零 JS 首屏 */}
  <section class="mb-10">
    <h1 class="text-4xl font-bold uppercase tracking-[0.18em] text-on-surface sm:text-6xl">
      {site.wordmark}
    </h1>
    <p class="mt-4 text-base text-on-surface-variant sm:text-lg">{site.tagline}</p>

    <div class="mt-6 flex flex-wrap items-center gap-3">
      {
        site.social.map((item) => (
          <a
            href={item.href}
            class="rounded-full bg-secondary-container px-4 py-2 text-xs font-medium text-on-surface hover:-translate-y-0.5"
          >
            {item.label}
          </a>
        ))
      }
    </div>
  </section>

  {/* 真实数据区：React island，进入视口才水合 */}
  <HomeFeed client:visible />
</Page>
