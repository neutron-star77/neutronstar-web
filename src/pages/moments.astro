---
import MainGridLayout from "../layouts/MainGridLayout.astro";
import MomentsList from "@components/islands/MomentsList";
import AuthButton from "@components/islands/AuthButton";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
---

<MainGridLayout title={i18n(I18nKey.moments)} page="moments">
	<div class="editorial-page editorial-moments"><div class="editorial-action"><AuthButton client:load /></div><MomentsList client:load /></div>
</MainGridLayout>

<style>
	.editorial-page { position: relative; }
	.editorial-action { position: absolute; top: -.6rem; right: 0; z-index: 2; }
</style>
