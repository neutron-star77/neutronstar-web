---
import MainGridLayout from "../layouts/MainGridLayout.astro";
import MomentsList from "@components/islands/MomentsList";
import AuthButton from "@components/islands/AuthButton";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";

// Kirameku 风格：说说页（便利贴堆叠 + 弹簧动画 + 只看这条评论 + 灯箱）
// 静态外壳包一层 .kirameku-page 渐变面板，页头在 MomentsList island 内
---

<MainGridLayout title={i18n(I18nKey.moments)} page="moments">
    <div class="kirameku-page">
        <div class="absolute right-4 top-4 sm:right-6 sm:top-5 z-20">
            <AuthButton client:load />
        </div>
        <MomentsList client:load />
    </div>
</MainGridLayout>
