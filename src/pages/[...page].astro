---
import Pagination from "@components/molecules/Pagination.astro";
import PostPage from "@components/organisms/PostPage.astro";
import { postListConfig } from "@/config/postListConfig";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { getArchivePage } from "@utils/content-utils";

// P2 数据换血：首页 SSR，文章来自 /bff/archive（BFF 边缘缓存 + 发布失效）
export const prerender = false;

const rawPage = Astro.params.page;
const pageNum = Math.max(1, Number.parseInt(rawPage ?? "1", 10) || 1);
const archive = await getArchivePage(pageNum, postListConfig.pageSize);
// PostPage 消费 page.data（与原版 astro Page 鸭子兼容）
const page = { ...archive, data: archive.posts };

const len = page.posts.length;
---

<MainGridLayout page="home">
    <PostPage page={page}></PostPage>
    <Pagination class="mx-auto onload-animation" page={page} style={`animation-delay: calc(var(--content-delay) + ${(len)*50}ms)`}></Pagination>
</MainGridLayout>
