---
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { apiGet } from "@/lib/server/api";

type ShelfBook = {
	id: number;
	slug: string;
	title: string;
	author: string | null;
	cover: string | null;
	summary: string;
	reading_status: string;
};

const shelf = (await apiGet<{ data?: ShelfBook[] } | ShelfBook[]>("/api/v1/shelf")) as
	| { data?: ShelfBook[] }
	| ShelfBook[]
	| null;
const books = Array.isArray(shelf) ? shelf : (shelf?.data ?? []);

// 小说页壳：Mizuki 视觉。
// 数据来自后续 reader 服务（/reader3 代理，见改动清单 §C2），当前未接入，
// 故渲染「内容待接入」空态；接入后在此通过 island 拉取书单/连载列表。
---

<MainGridLayout title="小说" description="书单与连载" page="novel">
    <div class="card-base onload-animation rounded-m3 bg-surface-container px-6 py-8">
        <h1 class="mb-2 text-xl font-bold text-on-surface">图书</h1>
        {books.length === 0 ? (
            <p class="text-sm leading-6 text-on-surface-variant">暂无已发布图书。</p>
        ) : (
            <div class="book-list">
                {books.map((book) => (
                    <a class="book-row" href={`/novel/${book.slug}/`}>
                        <span class="book-row__title">{book.title}</span>
                        <span class="book-row__meta">{book.author ?? "未知作者"} · {book.reading_status}</span>
                    </a>
                ))}
            </div>
        )}
    </div>
</MainGridLayout>

<style>
	.book-list { display: grid; gap: .5rem; margin-top: 1rem; }
	.book-row { display: flex; justify-content: space-between; gap: 1rem; padding: .85rem 0; border-bottom: 1px solid color-mix(in srgb, currentColor 12%, transparent); text-decoration: none; }
	.book-row__title { font-weight: 600; }
	.book-row__meta { color: var(--on-surface-variant); font-size: .8rem; }
	@media (max-width: 640px) { .book-row { display: grid; gap: .25rem; } }
</style>
