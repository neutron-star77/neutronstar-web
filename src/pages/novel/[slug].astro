---
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import { apiGet } from "@/lib/server/api";

type ShelfBook = {
	id: number;
	slug: string;
	title: string;
	author: string | null;
	cover: string | null;
	summary: string;
	reading_status: string;
	rating?: number | null;
	chapters?: Array<{ title: string; position: number }>;
};

export async function getStaticPaths() {
	const response = await apiGet<{ data?: ShelfBook[] } | ShelfBook[]>("/api/v1/shelf");
	const books = Array.isArray(response) ? response : (response?.data ?? []);
	return books.map((book) => ({ params: { slug: book.slug }, props: { book } }));
}

const book = Astro.props.book as ShelfBook | undefined;
---

<MainGridLayout title={book?.title ?? "图书"} page="novel">
	{book ? (
		<article class="book-detail">
			<p class="book-detail__eyebrow">{book.author ?? "未知作者"} · {book.reading_status}</p>
			<h1>{book.title}</h1>
			{book.summary && <p class="book-detail__summary">{book.summary}</p>}
			{book.rating != null && <p class="book-detail__rating">评分 {book.rating}</p>}
			{book.chapters && book.chapters.length > 0 && (
				<ol class="book-detail__chapters">
					{book.chapters.map((chapter) => <li>{chapter.title}</li>)}
				</ol>
			)}
		</article>
	) : (
		<p class="book-empty">图书不存在或暂未发布。</p>
	)}
</MainGridLayout>

<style>
	.book-detail { max-width: 46rem; margin: 0 auto; padding: 2rem 0 4rem; }
	.book-detail__eyebrow, .book-detail__rating { color: var(--on-surface-variant); font-size: .8rem; }
	.book-detail h1 { margin: .5rem 0 1rem; font-size: clamp(2rem, 5vw, 3.5rem); }
	.book-detail__summary { max-width: 38rem; color: var(--on-surface-variant); line-height: 1.8; }
	.book-detail__chapters { display: grid; gap: .5rem; margin-top: 2rem; padding-left: 1.4rem; line-height: 1.6; }
	.book-empty { color: var(--on-surface-variant); margin: 2rem 0; }
</style>
