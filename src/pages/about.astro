---
import Page from "../layouts/Page.astro";
import SurfaceCard from "../components/ui/SurfaceCard.astro";
import { site } from "../config/site";

const stacks = ["Astro 7", "Tailwind 4", "Cloudflare Workers", "FastAPI", "PostgreSQL"];
---

<Page
  title={`关于 · ${site.name}`}
  description={site.description}
  wordmark="ABOUT"
  meta={site.author.name}
>
  <SurfaceCard>
    <p class="text-sm leading-relaxed text-on-surface">
      你好，我是 {site.author.name}。{site.author.bio}
    </p>
    <p class="mt-3 text-sm leading-relaxed text-on-surface-variant">
      这个站点记录技术笔记、生活碎片与影像。内容存于自建后端，页面在边缘渲染，
      发布即生效。
    </p>
  </SurfaceCard>

  <div class="mt-4">
    <SurfaceCard title="Stack">
      <div class="flex flex-wrap gap-1.5">
        {
          stacks.map((s) => (
            <span class="rounded-full bg-secondary-container px-2.5 py-1 text-[11px] text-on-surface">
              {s}
            </span>
          ))
        }
      </div>
    </SurfaceCard>
  </div>
</Page>
