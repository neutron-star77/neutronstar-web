---
import MainGridLayout from "../../layouts/MainGridLayout.astro";

// P1 占位：不生成任何静态路由；P2 接真实数据时改回 getStaticPaths。
export function getStaticPaths() {
	return [];
}
---

<MainGridLayout title="文章" page="post">
    <div class="card-base onload-animation p-6">
        <h1 class="text-2xl font-bold mb-4">文章详情</h1>
        <p>P2 迁移：Shirone 原版 posts/[...slug]（Markdown 全管线 + 加密 + TOC）将在此移植。</p>
    </div>
</MainGridLayout>
