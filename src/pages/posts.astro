---
// 文章列表页（/posts）：卡片网格 + 分页，区别于按年份分组的 /archive。
// 导航「文章」直达本页，不再 301 → /archive（消除 swup/缓存对 3xx 的处理问题，
// 也满足「点文章进入真正列表」的预期）。
// 一代内网版静态化：构建期从 API 快照（存档定位；10 篇左右单页全览，查询参数分页不再生效）
export async function getStaticPaths() {
	await getArchivePage(1, 20);
	return [{ params: {} }];
}
import PagePagination from "@components/atoms/blog/PagePagination.astro";
import PostPage from "@components/organisms/PostPage.astro";
import LiveRefreshBanner from "@components/islands/LiveRefreshBanner";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { getArchivePage } from "@utils/content-utils";
import { url } from "@utils/url-utils";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";

// 内网存档版：单页全览（文章量小，size=20 覆盖全部；查询参数分页在静态托管下不再生效）
const STATIC_PAGE_SIZE = 20;

const rawPage = Astro.url.searchParams.get("page");
const pageNum = Math.max(1, Number.parseInt(rawPage ?? "1", 10) || 1);
const archive = await getArchivePage(pageNum, STATIC_PAGE_SIZE);
const page = {
	...archive,
	data: archive.posts,
	currentPage: archive.page,
	lastPage: archive.lastPage,
};
const len = page.posts.length;

const labels = {
	prev: i18n(I18nKey.paginationPrev),
	next: i18n(I18nKey.paginationNext),
	page: i18n(I18nKey.paginationPage),
	jump: i18n(I18nKey.paginationJump),
};
// 查询参数分页（/posts/?page=2），不占 /posts/N/ 路径（会被 [slug] 捕获）
const buildPagerUrl = (p: number) => url(p === 1 ? "/posts/" : `/posts/?page=${p}`);
---

<MainGridLayout title="文章" page="posts">
	<PostPage page={page}></PostPage>
	{page.lastPage > 1 && (
		<div
			class="mx-auto onload-animation mt-4"
			style={`animation-delay: calc(var(--content-delay) + ${len * 50}ms)`}
		>
			<PagePagination
				currentPage={page.currentPage}
				totalPages={page.lastPage}
				buildUrl={buildPagerUrl}
				{labels}
			/>
		</div>
	)}
</MainGridLayout>
<LiveRefreshBanner client:load />