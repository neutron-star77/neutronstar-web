---
import MainGridLayout from "../layouts/MainGridLayout.astro";
import TimelineRiver, { type RiverPost } from "@components/islands/TimelineRiver";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { getSortedPosts } from "@utils/content-utils";

// Kirameku 风格「时光河流」归档页：静态化后构建期全量文章下发，SVG 河流 + 横向拖拽。
// 原年度列表被替换；个人经历页 /timeline（data/timeline.ts）保持不变。
// 一代内网版静态化：构建期从 API 快照全量文章（存档定位）
export async function getStaticPaths() {
	await getSortedPosts();
	return [{ params: {} }];
}

const posts = await getSortedPosts();

const riverPosts: RiverPost[] = posts.map((p) => ({
  id: p.postId ?? 0,
  slug: p.slug,
  title: p.data.title,
  description: p.data.description ?? "",
  cover: p.data.image ?? "",
  category: p.data.category ?? "",
  views: p.views ?? 0,
  likes: p.likes ?? 0,
  published_at: p.data.published.toISOString(),
}));
---

<MainGridLayout title={i18n(I18nKey.archive)} page="archive">
    <div class="kirameku-page kirameku-page--river">
        <TimelineRiver posts={riverPosts} client:load />
    </div>
</MainGridLayout>
