---
import MainGridLayout from "../layouts/MainGridLayout.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { getSortedPosts } from "@utils/content-utils";

export async function getStaticPaths() { await getSortedPosts(); return [{ params: {} }]; }
const posts = await getSortedPosts();
---

<MainGridLayout title={i18n(I18nKey.archive)} page="archive">
	<div class="editorial-archive">
		{posts.map((post) => <article><time datetime={post.data.published.toISOString()}>{post.data.published.toLocaleDateString("zh-CN")}</time><div><p>{post.data.category || "记录"}</p><h2><a href={`/posts/${post.slug}/`}>{post.data.title}</a></h2>{post.data.description && <span>{post.data.description}</span>}</div></article>)}
	</div>
</MainGridLayout>

<style>
	.editorial-archive { border-top: 1px solid var(--editorial-rule); }
	.editorial-archive article { display: grid; grid-template-columns: 7rem 1fr; gap: 1rem; padding: 1.35rem 0; border-bottom: 1px solid var(--editorial-rule); }
	.editorial-archive time, .editorial-archive p { margin: 0; color: var(--editorial-muted); font: .68rem/1.4 var(--m3e-font-mono-family, monospace); }
	.editorial-archive h2 { margin: .3rem 0; font-size: 1.35rem; }
	.editorial-archive h2 a { text-decoration: none; }
	.editorial-archive span { color: var(--editorial-muted); font-size: .9rem; }
	@media (max-width: 600px) { .editorial-archive article { grid-template-columns: 1fr; gap: .45rem; } }
</style>
