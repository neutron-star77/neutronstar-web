---
import MainGridLayout from "../layouts/MainGridLayout.astro";
import ArchiveRiver from "@components/organisms/ArchiveRiver.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { getSortedPosts } from "@utils/content-utils";

export async function getStaticPaths() {
	const posts = await getSortedPosts();
	if (!posts.length) {
		// 构建期取数失败必须硬失败，防止静默上线空归墟
		throw new Error("[archive] 构建期文章列表为空——数据源取数失败，中止部署");
	}
	return [{ params: {} }];
}
const posts = await getSortedPosts();
---

<MainGridLayout title={i18n(I18nKey.archive)} page="archive">
	<div class="nebula-archive">
		<header class="nb-arch-head">
			<p class="nb-arch-kicker">ARCHIVE · RIVER OF TIME</p>
			<h1 class="nb-arch-title">时光河流</h1>
			<p class="nb-arch-desc">共 {posts.length} 篇文章 · 按住拖拽，沿星河回溯每一段记录。</p>
		</header>
		<ArchiveRiver posts={posts} />
	</div>
</MainGridLayout>

<style>
	.nebula-archive { position: relative; z-index: 10; color: var(--nebula-ink); padding-block: 1rem 2rem; }

	/* Nebula 页头：小字距 kicker + clamp 大标题 */
	.nb-arch-head { margin-bottom: 1.2rem; }
	.nb-arch-kicker {
		margin: 0 0 .55rem;
		font: 600 .72rem/1 var(--m3e-font-sans, Arial, sans-serif);
		letter-spacing: .14em;
		color: var(--nebula-ink-muted);
	}
	.nb-arch-title {
		margin: 0;
		font-size: clamp(1.7rem, 4vw, 2.6rem);
		font-weight: 800;
		line-height: 1.2;
		color: var(--nebula-ink);
	}
	.nb-arch-desc { margin: .5rem 0 0; color: var(--nebula-ink-muted); font-size: .9rem; }
</style>
